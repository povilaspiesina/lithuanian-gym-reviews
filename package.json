{
  "name": "lithuanian-gym-reviews",
  "version": "1.9.4",
  "private": true,
  "description": "Local Lithuanian gym review collector and dashboard",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test_*.js",
    "dist:win": "electron-builder --win nsis zip --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.10",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "lt.gymreviews.desktop",
    "productName": "Lithuanian Gym Reviews",
    "publish": [{ "provider": "github", "owner": "povilaspiesina", "repo": "lithuanian-gym-reviews" }],
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "maps_scraper.js",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/review_app.exe",
        "to": "backend/review_app.exe"
      },
      {
        "from": "bundle-browsers",
        "to": "browsers"
      },
      {
        "from": "gyms_lt.json",
        "to": "gyms_lt.json"
      },
      {
        "from": "verified_maps_places.json",
        "to": "verified_maps_places.json"
      },
      {
        "from": "seed",
        "to": "seed"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Lithuanian-Gym-Reviews-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true
    }
  }
}
